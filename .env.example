# Copy to .env and fill in your values
# Browser settings
HEADLESS=false           # true = no window (CI), false = visible browser
BROWSER_TIMEOUT=30000    # ms, page load timeout
SLOW_MO=500              # ms delay between Playwright actions (human-like)

# Pipeline concurrency
MAX_CONCURRENT_PRODUCTS=5   # parallel source products
MAX_CONCURRENT_SUPPLIERS=3  # parallel supplier detail scrapes

# Wangwang
WANGWANG_WAIT_REPLY_SEC=120   # seconds to wait for seller reply

# Logging
LOG_LEVEL=INFO
